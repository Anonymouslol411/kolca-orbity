# Настройки сайта. Обычно этот файл заполняет  sudo bash manage.sh install  — вручную править не нужно.
# После правки:  sudo bash manage.sh restart

# Домен (A-запись должна указывать на IP сервера). Без домена — работа по IP: DOMAIN=:80 и BASE_URL=http://IP
DOMAIN=:80
BASE_URL=http://IP_СЕРВЕРА
# Бесплатный адрес имя.duckdns.org (настраивает  sudo bash manage.sh duckdns)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Секреты (manage.sh генерирует сам)
SECRET_KEY=
# Секретный адрес админки: https://ВАШ_ДОМЕН/<ADMIN_PATH>/
ADMIN_PATH=

SITE_NAME=Kolca & Orbity
SUPPORT_EMAIL=
TIMEZONE=Europe/Moscow

# Цены в рублях. PRICE_MONTH=0 — убрать тариф «Месяц онлайн»
TRIAL_DAYS=3
PRICE_MONTH=329
PRICE_FOREVER=5000

# ---------- ЮMoney: оплата картой и кошельком, доступ открывается автоматически ----------
# Факт оплаты сервер проверяет сам — защищённым запросом к API ЮMoney (история операций кошелька).
# 1) Номер кошелька (41001...)
YOOMONEY_WALLET=
# 2) Приложение для доступа к API: yoomoney.ru/myservices/new
#    Redirect URI: https://ВАШ_ДОМЕН/yoomoney/oauth   → получите client_id (и client_secret, если включили)
YOOMONEY_CLIENT_ID=
YOOMONEY_CLIENT_SECRET=
# Redirect URI, указанный в приложении (пусто — BASE_URL/yoomoney/oauth)
YOOMONEY_REDIRECT_URI=
# 3) Токен получается командой  sudo bash manage.sh yoomoney-auth  и хранится в базе, не здесь.
# Необязательно: секрет HTTP-уведомлений (yoomoney.ru → Настройки → HTTP-уведомления,
# адрес https://ВАШ_ДОМЕН/webhooks/yoomoney). С ним оплата подтверждается за секунды, без него — в течение минуты.
YOOMONEY_SECRET=

# ---------- Перевод на карту: доступ открываете вы в админке после проверки ----------
# Оставьте CARD_NUMBER пустым, чтобы не показывать этот способ
CARD_NUMBER=
CARD_HOLDER=
CARD_BANK=

# ---------- Почта для восстановления пароля (необязательно) ----------
# Без SMTP ссылка сброса пишется в журнал: sudo bash manage.sh logs | grep "Ссылка сброса"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
